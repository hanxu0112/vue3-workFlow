{
  "name": "vue3-ts-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --mode production",
    "build:gh-pages": "vite build --mode production",
    "build:sit": "vue-tsc -b && vite build --mode sit",
    "build:uat": "vue-tsc -b && vite build --mode uat",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@antv/layout": "^2.0.0",
    "@antv/x6": "^3.1.8",
    "@antv/x6-vue-shape": "^3.0.2",
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.4",
    "tslib": "^2.8.1",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
